  RewriteRule ^wp-content/uploads/2026/02/icon\-17263(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/icons/members-deals.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/icon\-72431(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/icons/point-tracking.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/icon\-761423(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/icons/welcome-points.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/icon\-861523(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/icons/redeem.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/image(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/saunas/card-amethyst-salt.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/salt\-room(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/saunas/card-salt-dome.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/smiling\-young\-woman\-procedure\-face(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/treatments/facial-treatment.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/02/unnamed\-90(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/saunas/bulgama-guest.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/03/Desktop\-4\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/backgrounds/banner-red-lion.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/03/Group\-1597881732\-1\-scaled\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/treatments/body-scrub-oil-red.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/03/Group\-1597881732\-scaled\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/treatments/body-scrub-back-red-wide.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/03/V\-steam1\-scaled\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/treatments/foot-massage-red.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/04/1776172152757(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/blog/authentic-korean-spa-experience.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/04/King_Spa_and_Sauna_Full_Size31\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/facility/red-healing-room-wide.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/10/00\-image\-fixed(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/promo/fall-sale-banner.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/10/02\-curved\-heated\-therapy\-room\-with\-reclinin(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/promo/heated-therapy-room.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/10/03\-warm\-wood\-lined\-sauna\-room\-at\-king\-spa\-c(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/promo/restaurant.jpg [R=301,L,NC]
  # The $45 e-coupon image in e-mails already sent stays at its old address (a real file);
  # other WordPress media that no page uses anymore: 410 Gone.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^wp-content/uploads/ - [G,L,NC]

  # WordPress sitemaps -> the new sitemap.
  RewriteRule ^(?:sitemap_index|wp-sitemap(?:-[a-z0-9_-]+)?)\.xml$ https://%{HTTP_HOST}/sitemap.xml [R=301,L,NC]
  # WordPress-only paths that no longer exist: 410 Gone, so search engines drop them.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|wp-content)(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post|wp-links-opml|wp-mail)\.php$ - [G,L,NC]
  RewriteRule ^wp-sitemap.*\.xsl$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|trackback|embed)/?$ - [G,L,NC]
  RewriteRule ^(?:blog|category/[^/]+|author/[^/]+)/page/\d+/?$ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id|preview|s)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old WordPress URLs ----

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind SiteGround's proxy are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=63072000"

  # CSP for the site. Third parties allowed: Google Tag Manager / Analytics, the
  # Elfsight Google Reviews widget, Google Maps embeds, Sanity images, and the
  # GoHighLevel (LeadConnector) chat once its ID is set. If you add tags in GTM
  # that load other scripts, add their domains here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://elfsightcdn.com https://*.elfsightcdn.com https://*.elfsight.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://elfsightcdn.com https://*.elfsightcdn.com https://*.elfsight.com https://fonts.googleapis.com https://*.leadconnectorhq.com https://*.msgsndr.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://elfsightcdn.com https://*.elfsightcdn.com https://*.elfsight.com https://*.leadconnectorhq.com https://*.msgsndr.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://elfsightcdn.com https://*.elfsightcdn.com https://*.elfsight.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com https://*.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.googletagmanager.com https://*.elfsight.com https://www.youtube.com https://www.youtube-nocookie.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, photos for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# Compress text files. Apache serves .js as text/javascript, so both JavaScript types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>
