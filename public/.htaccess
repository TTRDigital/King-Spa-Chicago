  RewriteRule ^wp-content/uploads/2025/12/King\-Spa\-Sauna\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/brand/king-spa-sauna-logo.png [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/12/King\-Spa\-Sauna\-1\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/saunas/guests-resting-bamboo-mats.png [R=301,L,NC]
