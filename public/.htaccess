# King Spa Chicago: static Next.js export on SiteGround (Apache).
# Does what a Node server would: canonical host, trailing slashes, headers, caching.

Options -Indexes
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: https://chi.kingspa.com. Any other host name that reaches this
  # folder (the SiteGround temporary address *.sg-host.com, www., a bare IP) and
  # plain http are sent there. Turn on SiteGround's "HTTPS Enforce" as well.
  RewriteCond %{HTTP_HOST} !^chi\.kingspa\.com$ [NC]
  RewriteRule ^(.*)$ https://chi.kingspa.com/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://chi.kingspa.com/$1 [R=301,L]

  # ---- Old WordPress URLs (keep above the slash rule) ----
  # Every page and post keeps its old address; these are the WordPress-only extras.

  # ?page_id= / ?p= short links: 301 to the page, query dropped.
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=13(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=293(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/pricing/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=318(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/body-scrub/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=352(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/e-coupon/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=494(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/about/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=509(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/facials/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=514(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/massagetherapy/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=523(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/sauna-healing-rooms/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=609(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/first-time-guide/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=646(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/contact/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=704(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/blog/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=832(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/v-steam/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=1036(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/reward/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=1317(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/body-scrub/mens-body-scrubs/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=1395(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/body-scrub/womens-body-scrubs/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=1573(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/fall-sale/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:page_id|p)=1447(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/uncategorized/the-authentic-korean-spa-experience/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)author=1(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/author/ttr/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)author=3(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/author/ahsan/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)author=4(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/author/subhan/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)author=6(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/author/ryan/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (?:^|&)cat=1(?:&|$)
  RewriteRule ^(?:index\.php)?$ https://%{HTTP_HOST}/category/uncategorized/ [R=301,L,QSD]

  # Photos from /wp-content/uploads (every WordPress size) -> the same photo's new address.
  RewriteRule ^wp-content/uploads/2025/12/DSC07318(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/treatments/mens-body-scrub.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/12/Gallery\-4(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.jpg$ https://%{HTTP_HOST}/images/facility/lounge-red-chairs.jpg [R=301,L,NC]
