  RewriteRule ^wp-content/uploads/2025/12/Photos\-Operations\-3\-1(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/gallery/sauna-door-mural.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/12/Photos\-Operations\-3\-2(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/gallery/dining-utensil-station.webp [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2025/12/Photos\-Operations\-3\-3(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.webp$ https://%{HTTP_HOST}/images/gallery/korean-meals.webp [R=301,L,NC]
