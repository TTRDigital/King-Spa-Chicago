  RewriteRule ^wp-content/uploads/2025/12/Group\-1597883733(?:-scaled)?(?:-e\d+)?(?:-\d+x\d+)?\.png$ https://%{HTTP_HOST}/images/facility/fire-sudatorium-lounge-arch.png [R=301,L,NC]
